<?xml version="1.0" encoding="UTF-8"?>
<!--
  Root Maven project for DeepSeek Harness Java SDK (deepseek-harness4j-sdk).

  This project is a line-by-line Java port of the DeepSeek Harness Python SDK
  (python/sdk + python/sdk-runtime in the upstream deepseek-harness repository).
  Modules:
    - deepseek-harness4j-sdk-core               core client + high-level turns API + runtime resolution
    - deepseek-harness4j-sdk-spring-boot-starter  Spring Boot auto-configuration around the SDK
    - deepseek-harness4j-sdk-spring-boot-example  runnable Spring Boot MVC example

  JDK: targets Java 8 (1.8) via maven.compiler.source/target so the SDK runs on legacy
  JDK 8 deployments. When building on JDK 9+ a profile activates maven.compiler.release=8
  so javac also checks the compiled code against the JDK 8 API surface. Spring Boot is
  pinned to 2.7.x, the last Spring Boot line that supports Java 8.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.m310851010</groupId>
  <artifactId>deepseek-harness4j-sdk</artifactId>
  <version>0.0.1</version>
  <packaging>pom</packaging>

  <name>deepseek-harness4j-sdk</name>
  <description>Enterprise Java SDK &amp; Agent Runtime Framework for DeepSeek Harness (DeepSeek-R1 / V3)</description>
  <url>https://github.com/m310851010/deepseek-harness4j-sdk</url>
  <licenses>
    <license>
      <name>MIT</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>m310851010</id>
      <name>m310851010</name>
      <url>https://github.com/m310851010</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/m310851010/deepseek-harness4j-sdk.git</connection>
    <developerConnection>scm:git:git@github.com:m310851010/deepseek-harness4j-sdk.git</developerConnection>
    <url>https://github.com/m310851010/deepseek-harness4j-sdk</url>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>1.8</maven.compiler.source>
    <maven.compiler.target>1.8</maven.compiler.target>
    <jackson.version>2.17.2</jackson.version>
    <junit.version>5.10.2</junit.version>
    <spring.boot.version>2.7.18</spring.boot.version>
    <slf4j.version>2.0.16</slf4j.version>
  </properties>

  <modules>
    <module>sdk</module>
    <module>spring-boot-starter</module>
    <module>spring-boot-example</module>
  </modules>

  <profiles>
    <!-- On JDK 9+ cross-compile with the javac "release" flag set to 8 so javac verifies
         the code only uses the JDK 8 API surface. JDK 8 itself has no such flag, so the
         default source/target 1.8 configuration applies there. -->
    <profile>
      <id>jdk9-plus</id>
      <activation>
        <jdk>[9,)</jdk>
      </activation>
      <properties>
        <maven.compiler.release>8</maven.compiler.release>
      </properties>
    </profile>

    <!-- 发布到 Maven Central(central.sonatype.com Central Portal):
         mvn clean deploy -Pcentral-release
         前置条件: ~/.m2/settings.xml 配置 id=central 的 Portal User Token,
         本机 GPG 私钥存在且公钥已上传到公钥服务器。 -->
    <profile>
      <id>central-release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.8.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <excludeModules>spring-boot-example</excludeModules>
              <autoPublish>true</autoPublish>
              <waitUntil>uploaded</waitUntil>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.1</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.11.2</version>
            <configuration>
              <!-- 关闭 JDK8 严格 doclint:注释中的 {@link java.util.concurrent.Flow.*}
                   是 Java 9+ API,JDK8 javadoc 解析不到;发布校验只要求 javadoc jar 存在 -->
              <doclint>none</doclint>
              <charset>UTF-8</charset>
              <encoding>UTF-8</encoding>
              <docencoding>UTF-8</docencoding>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.7</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
